APP_NAME=NUTRAMOVE API
ENVIRONMENT=development
# Replace the placeholder; use the same credentials configured in infra/.env.
DATABASE_URL=postgresql+psycopg://nutramove:replace-me@localhost:5432/nutramove
# JSON list of explicitly allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]

SESSION_SECONDS=3600
# Enable in production, together with HTTPS origins.
COOKIE_SECURE=false

# IANA timezone used for hydration day boundaries.
BUSINESS_TIMEZONE=America/Sao_Paulo

# Enable only after configuring a provider key. Student data will be sent externally.
AI_ENABLED=false
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=45

# Required in production: stable random secret (at least 32 characters) shared by all API replicas.
# Development generates a temporary secret when omitted.
RATE_LIMIT_SECRET=
# Defaults to enabled outside production and disabled in production.
# DOCS_ENABLED=false
# Private progress photos (not publicly served)
PRIVATE_UPLOAD_DIR=./private_uploads
MAX_PHOTO_BYTES=8388608
