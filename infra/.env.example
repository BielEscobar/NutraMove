POSTGRES_DB=nutramove
POSTGRES_USER=nutramove
# Set a local password before starting Compose. Use URL-safe characters.
POSTGRES_PASSWORD=

# IANA timezone used for hydration day boundaries.
BUSINESS_TIMEZONE=America/Sao_Paulo

# NutraMove AI (external provider; disabled by default).
AI_ENABLED=false
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
