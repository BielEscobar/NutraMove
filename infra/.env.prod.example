# Copy to infra/.env.prod on the VPS; never commit the filled file. Restrict to chmod 600.
# Domains are hostnames without https://. Both A records must point to the VPS.
APP_DOMAIN=app.example.com.br
API_DOMAIN=api.example.com.br
ACME_EMAIL=operator@example.com.br

# Set DEPLOY_TAG to the exact, committed Git SHA being deployed.
DEPLOY_TAG=

# Use a unique, random, URL-safe password (no punctuation requiring URL encoding).
POSTGRES_DB=nutramove
POSTGRES_USER=nutramove
POSTGRES_PASSWORD=

# At least 32 random characters; stable across backend restarts/replicas.
RATE_LIMIT_SECRET=
BUSINESS_TIMEZONE=America/Sao_Paulo

# NutraMove AI is opt-in. Keep the key only in the untracked production env file.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
